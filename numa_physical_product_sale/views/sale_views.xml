<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sale_order_physical_form_view">
            <field name="name">sale.order.physical.form</field>
            <field name="model">sale.order</field>
            <field name="mode">extension</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <!--
                    [20.0] The order lines list groups its fields in `<column>` wrappers
                    now (product_and_description, sol_qty, sol_uom, price_unit), so
                    `list/field[@name='name']` and `list/field[@name='price_unit']`
                    are no longer direct children and could not be located. The inner
                    `<form>` still exists, but `name` is nested inside it rather than a
                    direct child.
                -->
                <xpath expr="//field[@name='order_line']/form//field[@name='name']" position="after">
                    <group invisible="not display_type">
                        <group>
                            <field name="unit_width"/>
                            <field name="unit_length"/>
                            <field name="unit_height"/>
                        </group>
                        <group>
                            <field name="unit_surface"/>
                            <field name="unit_weight"/>
                            <field name="unit_volume"/>
                        </group>
                        <group>
                            <field name="total_surface"/>
                            <field name="total_weight"/>
                            <field name="total_volume"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//field[@name='order_line']/list//column[@name='product_and_description']" position="after">
                    <field name="unit_width" optional="hide"/>
                    <field name="unit_length" optional="hide"/>
                    <field name="unit_height" optional="hide"/>
                    <field name="unit_surface" optional="hide"/>
                    <field name="unit_weight" optional="hide"/>
                    <field name="unit_volume" optional="hide"/>
                    <field name="total_surface" optional="hide"/>
                    <field name="total_weight" optional="hide"/>
                    <field name="total_volume" optional="hide"/>
                </xpath>
                <!--
                    `price_qty` no longer needs `readonly="True" force_save="True"`:
                    it is a computed stored field now, so the server fills it and the
                    client has nothing to send back.
                -->
                <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                    <field name="price_qty"/>
                    <field name="unit_price_uom_id"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list//column[@name='price_unit']" position="after">
                    <field name="price_qty" optional="show"/>
                    <field name="unit_price_uom_id" optional="show"/>
                </xpath>
                <xpath expr="//group[@name='sales_person']" position="before">
                    <group string="Package Information" name="package_information">
                        <field name="so_weight"/>
                        <field name="so_volume"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
