<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- FSM Definition -->
        <record model="ir.ui.view" id="definition_form_view">
            <field name="name">FSM Definition form</field>
            <field name="model">fsm.definition</field>
            <field name="arch" type="xml">
                <form string="FSM Definition">
                    <header>
                        <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="is_verified"/>
                        <button name="action_set_test" type="object" string="Set to Test" invisible="state != 'draft'"/>
                        <button name="action_set_production" type="object" string="Set to Production" class="btn-success" invisible="state != 'test'"/>
                        <button name="action_set_draft" type="object" string="Back to Draft" invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,test,production"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-check-shield" invisible="not is_verified">
                                <div class="o_stat_info">
                                    <span class="o_stat_text text-success">Verified</span>
                                </div>
                            </button>
                        </div>
                        <group name="top">
                            <field name="name" />
                            <field name="is_verified" invisible="1"/>
                            <field name="website_form_id" invisible="1"/>
                        </group>
                        <notebook>
                            <page name="designer" string="Designer">
                                <group>
                                    <field name="json_ui_schema" widget="fsm_diagram" nolabel="1" class="o_full_width"/>
                                </group>
                            </page>
                            <page name="advanced" string="Advanced">
                                <group>
                                    <field name="execution_policy"/>
                                </group>
                            </page>
                            <page name="pages" string="Pages">
                                <field name="pages" mode="list">
                                    <list>
                                        <field name="name"/>
                                        <button name="open_page_template" type="object" string="View"/>
                                    </list>
                                </field>
                            </page>
                            <page name="mail_templates" string="Mail templates">
                                <field name="mail_templates" mode="list">
                                    <list>
                                        <field name="name"/>
                                        <button name="open_mail_template" type="object" string="Edit"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="definition_list_view">
            <field name="name">FSM Definition list view</field>
            <field name="model">fsm.definition</field>
            <field name="arch" type="xml">
                <list string="FSM Definitions">
                    <field name="name" />
                    <field name="type" />
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="definition_search_view">
            <field name="name">FSM Definition search view</field>
            <field name="model">fsm.definition</field>
            <field name="arch" type="xml">
                <search string="FSM Definition search">
                    <field name="name" />
                    <field name="type" />
                    <group expand="0" name="group_by" string="Group By">
                        <filter string="type" name="group_type" context="{'group_by': 'type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="definition_action">
            <field name="name">Workflows</field>
            <field name="res_model">fsm.definition</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- FSM Instance -->
        <record model="ir.ui.view" id="instance_form_view">
            <field name="name">FSM Instance form</field>
            <field name="model">fsm.instance</field>
            <field name="arch" type="xml">
                <form string="FSM Instance">
                    <header>
                        <button name="start" type="object" string="Start" invisible="state != 'init'"/>
                        <button name="end" type="object" string="End" invisible="state != 'running'"/>
                        <button name="action_debug_next_step" type="object" string="Next Step" class="btn-primary" invisible="state != 'paused'"/>
                        <button name="action_debug_continue" type="object" string="Continue" class="btn-secondary" invisible="state != 'paused'"/>
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="definition_id" />
                            <field name="debug_mode" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <notebook>
                            <page name="status" string="Status">
                                <group>
                                    <group string="Execution State">
                                        <field name="current_state_id" readonly="1"/>
                                        <field name="next_node_id" readonly="1"/>
                                    </group>
                                    <group string="Variables">
                                        <field name="instance_variables" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                                        <field name="intermediate_variables" widget="ace" options="{'mode': 'json'}" readonly="1" invisible="not intermediate_variables"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Debugger" name="debugger_page">
                                <group>
                                    <div class="alert alert-info" role="alert" invisible="state != 'paused'">
                                        Execution Paused. Inspect variables and use 'Next Step' or 'Continue' to proceed.
                                    </div>
                                </group>
                                <field name="definition_id" invisible="1"/>
                                <field name="current_state_id" invisible="1"/>
                                <field name="next_node_id" invisible="1"/>
                                <field name="json_ui_schema"
                                       widget="fsm_diagram"
                                       nolabel="1"
                                       class="o_full_width"
                                       readonly="1"
                                       activeNodeId="state == 'paused' ? next_node_id : current_state_id"
                                />
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="instance_list_view">
            <field name="name">FSM Instance list view</field>
            <field name="model">fsm.instance</field>
            <field name="arch" type="xml">
                <list string="FSM Instances">
                    <field name="name" />
                    <field name="definition_id" />
                    <field name="state" />
                    <field name="current_state_id" />
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="instance_search_view">
            <field name="name">FSM Instance search view</field>
            <field name="model">fsm.instance</field>
            <field name="arch" type="xml">
                <search string="FSM Instance search">
                    <field name="name" />
                    <field name="definition_id" />
                    <field name="state" />
                    <field name="current_state_id" />
                    <group expand="0" name="filtered_by" string="Filtered By">
                        <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                        <filter string="Paused" name="paused" domain="[('state', '=', 'paused')]"/>
                    </group>
                    <group expand="0" name="group_by" string="Group By">
                        <filter string="Definition" name="group_definition" context="{'group_by': 'definition_id'}"/>
                        <filter string="Instance State" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="instance_action">
            <field name="name">Instances</field>
            <field name="res_model">fsm.instance</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- FSM Mail template -->
        <record model="ir.ui.view" id="mail_template_form_view">
            <field name="name">FSM Template form</field>
            <field name="model">fsm.wf.mail_template</field>
            <field name="arch" type="xml">
                <form string="Mail template">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="render_model" readonly="False" />
                            <field name="body_html" widget="ace" options="{'mode': 'html'}"/>
                        </group>
                        <group name="attachments" string="Attachments">
                            <field name="attachment_ids" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- FSM Page template -->
        <record model="ir.ui.view" id="page_template_form_view">
            <field name="name">FSM Template form</field>
            <field name="model">fsm.wf.page_template</field>
            <field name="arch" type="xml">
                <form string="Mail template">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="body" widget="ace" options="{'mode': 'python'}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
