<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Standalone views for FSM Execution Log with Replay button -->

        <record id="fsm_execution_log_tree_view" model="ir.ui.view">
            <field name="name">fsm.execution.log.tree</field>
            <field name="model">fsm.execution.log</field>
            <field name="arch" type="xml">
                <tree string="Execution Logs" create="0" delete="0">
                    <field name="timestamp"/>
                    <field name="instance_id"/>
                    <field name="event_name"/>
                    <field name="from_state"/>
                    <field name="to_state"/>
                    <field name="status"/>
                    <field name="log_type"/>
                    <button name="action_replay_simulation"
                            type="object"
                            string="Simulate Replay"
                            class="btn-link fa fa-history"
                            title="Simulate Replay"/>
                </tree>
            </field>
        </record>

        <record id="fsm_execution_log_form_view" model="ir.ui.view">
            <field name="name">fsm.execution.log.form</field>
            <field name="model">fsm.execution.log</field>
            <field name="arch" type="xml">
                <form string="Execution Log">
                    <header>
                        <button name="action_replay_simulation" type="object"
                                string="Simulate Replay" class="btn-primary fa fa-play-circle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="timestamp"/>
                                <field name="instance_id"/>
                                <field name="event_name"/>
                                <field name="status"/>
                                <field name="log_type"/>
                            </group>
                            <group>
                                <field name="from_state"/>
                                <field name="to_state"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Input Snapshot">
                                <field name="input_snapshot" widget="ace" options="{'mode': 'json'}"/>
                            </page>
                            <page string="Output Snapshot">
                                <field name="output_snapshot" widget="ace" options="{'mode': 'json'}"/>
                            </page>
                            <page string="Error">
                                <field name="error_msg" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
