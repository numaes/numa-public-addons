<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mail_layout">
        <t t-raw="body_html or body" />
    </template>

    <template id="page_template" name="Page for Workflow">
        <t name="Workflow" t-name="numa_fsm.page_template">
            <t t-call="website.layout">
                <div>
                    <div class="oe_structure">
                        <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                            <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_banner_default_image'); background-position: 50% 0;"/>
                            <div class="o_we_bg_filter bg-black-50"/>
                            <div class="container">
                                <h1 t-esc="page.name"/>
                            </div>
                        </section>
                    </div>
                    <div class="container mt-4 mb-5">
                        <t t-raw="processed_body"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="page_edit_template" name="Edit Workflow Page">
        <t name="Edit page" t-name="numa_fsm.page_edit_template">
            <t t-call="website.layout">
                <div>
                    <div class="oe_structure">
                        <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                            <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_banner_default_image'); background-position: 50% 0;"/>
                            <div class="o_we_bg_filter bg-black-50"/>
                            <div class="container">
                                <h1 t-field="page.name"/>
                            </div>
                        </section>
                    </div>
                    <div class="container mt-4 mb-5">
                        <span t-field="page.body"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="error_page" name="Page Not Found">
        <t name="Workflow" t-name="numa_fsm.error_page">
            <t t-call="website.layout">
                <div>
                    <div class="oe_structure">
                        <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                            <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_banner_default_image'); background-position: 50% 0;"/>
                            <div class="o_we_bg_filter bg-black-50"/>
                            <div class="container">
                                <h1>Error</h1>
                            </div>
                        </section>
                    </div>
                    <div class="container mt-4 mb-5">
                        <div itemprop="description"
                            t-esc="message"
                            class="oe_structure oe_empty mt16"
                            id="page_body"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="mail_template" name="Mail template for Workflow">
        <style id="design-element">
            h2 {
                font-weight: bolder;
            }
            p, p > *, li, li > * {
                color: #6c757d;
            }
            a:not(.btn), a.btn.btn-link {
                font-weight: bolder;
            }
            hr {
                border-top-color: #ced4da !important;
            }
        </style>
        <div class="s_header_logo o_mail_block_header_logo o_mail_snippet_general pt16 pb16">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4"/>
                    <div class="col-lg-4" style="text-align: center;">
                        <a t-att-href="(company_id.website) or '#'" style="text-decoration:none;" target="_blank">
                            <img border="0" src="/mass_mailing/static/src/img/theme_default/s_default_image_header_logo.png" style="height:auto; max-width:100%;" width="180" class="img-fluid"/>
                        </a>
                    </div>
                    <div class="col-lg-4" style="text-align: right;"/>
                </div>
            </div>
        </div>
        <div class="s_text_block o_mail_snippet_general pt40 pb16" style="padding-left: 15px; padding-right: 15px;">
            <div class="container s_allow_columns">
                <div class="container mt-4 mb-5">
                    <t t-raw="0"/>
                </div>
            </div>
        </div>
    </template>

</odoo>
