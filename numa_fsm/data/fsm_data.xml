<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
		<!-- Scheduler for FSM Timers-->
		<record forcecreate="True" id="ir_cron_fsm_timers"
			model="ir.cron">
            <field name='name'>FSM: Main timer survillance</field>
            <field name='interval_number'>1</field>
            <field name='interval_type'>minutes</field>
            <field name="active">True</field>
            <field name="model_id" ref="model_fsm_timer"/>
            <field name="state">code</field>
            <field name="code">model.schedule_timers()</field>
		</record>
    </data>

    <data noupdate="0">
        <record id="numa_fsm.model_fsm_form_input" model="ir.model">
          <field name="website_form_key">unrelated_identifier</field>
          <field name="website_form_access">True</field>
          <field name="website_form_label">Form input for workflows</field>
        </record>
        <function model="ir.model.fields" name="formbuilder_whitelist">
          <value>fsm.form_input</value>
          <value eval="[
            'instance_id',
            'unrelated_identifier',
            ]"/>
        </function>
    </data>
</odoo>
