<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
		<!-- Scheduler for FSM Timers (DEPRECATED - Now using numa_asynch_exec with retry_count = -1) -->
		<!-- This cron is kept for backward compatibility but should remain inactive -->
		<!-- Timer processing is now handled by _process_timers() via numa_asynch_exec -->
		<record forcecreate="True" id="ir_cron_fsm_timers"
			model="ir.cron">
            <field name='name'>FSM: Main timer survillance (DEPRECATED)</field>
            <field name='interval_number'>1</field>
            <field name='interval_type'>minutes</field>
            <field name="active">False</field>
            <field name="model_id" ref="model_fsm_timer"/>
            <field name="state">code</field>
            <field name="code">model.schedule_timers()</field>
		</record>
    </data>

    <data noupdate="1">
    </data>
</odoo>
