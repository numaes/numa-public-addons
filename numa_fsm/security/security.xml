<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_fsm_services">
            <field name="name">FSM Services</field>
            <field name="sequence">50</field>
        </record>

        <!-- [fsm][20.0] res.groups.category_id no longer exists: the grouper
             of groups is now res.groups.privilege (res_groups_privilege.py:5),
             which does point to an ir.module.category. -->
        <record model="res.groups.privilege" id="fsm_services_privilege">
            <field name="name">FSM Services</field>
            <field name="category_id" ref="module_category_fsm_services"/>
            <field name="sequence">50</field>
        </record>

        <record id="viewer_group" model="res.groups">
            <field name="name">Show FSM Services</field>
            <field name="privilege_id" ref="fsm_services_privilege"/>
        </record>

        <record id="fsm_administrator_group" model="res.groups">
            <field name="name">FSM Administrator</field>
            <field name="privilege_id" ref="fsm_services_privilege"/>
            <field name="implied_ids" eval="[Command.link(ref('numa_fsm.viewer_group'))]"/>
            <!-- [fsm][20.0] The module used to edit base.group_system to add
                 itself to its implied_ids. The 20.0 idiom is to declare it
                 from here, without touching a record owned by someone else. -->
            <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
