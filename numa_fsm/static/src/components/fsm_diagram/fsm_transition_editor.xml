<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMTransitionEditor" owl="1">
        <div class="o_fsm_editor_panel">
            <div class="o_fsm_editor_header">
                <h3>Edit Transition</h3>
                <button class="btn-close" t-on-click="this.props.onClose"/>
            </div>
            <div class="o_fsm_editor_body">
                <div class="mb-3">
                    <label for="eventName" class="form-label">Event Name</label>
                    <input type="text" class="form-control" id="eventName" t-custom-model="this.state.eventName"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Code</label>
                    <CodeEditor
                        mode="this.python"
                        value="this.state.code"
                        onChange.bind="this.onCodeChange"
                    />
                </div>
                <div class="mb-3">
                    <label class="form-label">Outcomes</label>
                    <div t-foreach="this.state.outcomes" t-as="outcome" t-key="outcome_index" class="input-group mb-2">
                        <input type="text" class="form-control" placeholder="Outcome Name" t-custom-model="outcome.name"/>
                        <button class="btn btn-outline-danger" t-on-click="() => this.removeOutcome(outcome_index)">
                            <i class="oi" data-icon="delete"/>
                        </button>
                    </div>
                    <button class="btn btn-secondary btn-sm" t-on-click="this.addOutcome">
                        <i class="oi" data-icon="add"/> Add Outcome
                    </button>
                </div>
            </div>
            <div class="o_fsm_editor_footer">
                <button class="btn btn-primary" t-on-click="this.save">Save</button>
                <button class="btn btn-secondary" t-on-click="this.props.onClose">Cancel</button>
            </div>
        </div>
    </t>
</templates>
