<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMNode" owl="1">
        <div class="o_fsm_node"
             t-ref="node"
             t-att-class="'o_fsm_node_' + props.node.type"
             t-att-style="'transform: translate(' + props.node.x + 'px, ' + props.node.y + 'px); position: absolute; background-color: white; border: 1px solid #ccc; min-width: 150px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); border-radius: 4px;'"
             t-on-mousedown="onNodeMouseDown"
             t-on-dblclick.stop="onNodeDblClick">

            <!-- Input Port (All except Start) -->
            <div t-if="props.node.type !== 'start'" class="o_fsm_port o_fsm_port_in"
                 t-att-data-node-id="props.node.id" data-port-type="in"
                 style="width: 12px; height: 12px; background-color: #ddd; border: 1px solid #999; border-radius: 50%; position: absolute; left: -6px; top: 50%; transform: translateY(-50%); cursor: crosshair;"/>

            <div class="o_fsm_node_header" style="padding: 5px 10px; font-weight: bold; border-bottom: 1px solid #ccc; background-color: #f8f9fa;">
                <t t-esc="props.node.label"/>
            </div>

            <!-- Body (Visible for all types except End) -->
            <div t-if="props.node.type !== 'end'" class="o_fsm_node_body" style="padding: 10px;">
                <!-- Output Ports: State (Events) -->
                <t t-if="props.node.type === 'state'">
                    <div t-foreach="props.node.events || []" t-as="event" t-key="event.name" class="o_fsm_port_out_wrapper" style="display: flex; justify-content: space-between; align-items: center; padding: 2px 0; position: relative;">
                        <span><t t-esc="event.name"/></span>
                        <div class="o_fsm_port o_fsm_port_out"
                             t-att-data-node-id="props.node.id"
                             t-att-data-port-name="event.name"
                             t-on-mousedown="(ev) => this.onPortMouseDown(ev, event.name)"
                             style="width: 12px; height: 12px; background-color: #ddd; border: 1px solid #999; border-radius: 50%; position: absolute; right: -16px; cursor: crosshair;"/>
                    </div>
                </t>

                <!-- Output Ports: Transition & Start (Outcomes) -->
                <t t-if="props.node.type === 'transition' || props.node.type === 'start'">
                    <!-- Always show Default outcome -->
                    <div class="o_fsm_port_out_wrapper" style="display: flex; justify-content: space-between; align-items: center; padding: 2px 0; position: relative;">
                        <span class="text-muted"><i>default</i></span>
                        <div class="o_fsm_port o_fsm_port_out"
                             t-att-data-node-id="props.node.id"
                             t-att-data-port-name="__default__"
                             t-on-mousedown="(ev) => this.onPortMouseDown(ev, '__default__')"
                             style="width: 12px; height: 12px; background-color: #ddd; border: 1px solid #999; border-radius: 50%; position: absolute; right: -16px; cursor: crosshair;"/>
                    </div>
                    <!-- Show other named outcomes -->
                    <t t-foreach="Object.keys(props.node.outcomes || {})" t-as="outcome" t-key="outcome">
                        <div t-if="outcome !== '__default__'" class="o_fsm_port_out_wrapper" style="display: flex; justify-content: space-between; align-items: center; padding: 2px 0; position: relative;">
                            <span><t t-esc="outcome"/></span>
                            <div class="o_fsm_port o_fsm_port_out"
                                 t-att-data-node-id="props.node.id"
                                 t-att-data-port-name="outcome"
                                 t-on-mousedown="(ev) => this.onPortMouseDown(ev, outcome)"
                                 style="width: 12px; height: 12px; background-color: #ddd; border: 1px solid #999; border-radius: 50%; position: absolute; right: -16px; cursor: crosshair;"/>
                        </div>
                    </t>
                </t>
            </div>
        </div>
    </t>
</templates>
