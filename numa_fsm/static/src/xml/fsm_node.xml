<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMNode" owl="1">
        <div class="o_fsm_node"
             t-ref="this.nodeRef"
             t-att-data-node-id="this.props.node.id"
             t-att-class="{
                'o_fsm_node_active': this.props.activeNodeId === this.props.node.id,
                'o_fsm_node_selected': this.props.selected,
                'o_fsm_node_hover': this.props.hovered,
                'o_fsm_node_connecting': this.props.isConnecting,
                'o_fsm_node_global': this.props.node.is_global &amp;&amp; this.props.node.type === 'state',
                ['o_fsm_node_' + this.props.node.type]: true
             }"
             t-att-style="'transform: translate(' + this.props.node.x + 'px, ' + this.props.node.y + 'px);'"
             t-on-mouseenter="this.onMouseEnter"
             t-on-mouseleave="this.onMouseLeave">

            <div t-if="this.props.node.type !== 'start'" class="o_fsm_port o_fsm_port_in" t-att-data-node-id="this.props.node.id" data-port-type="in"/>

            <div class="o_fsm_node_header">
                <i t-if="this.props.node.is_breakpoint" class="oi me-2" data-icon="back_hand" title="Breakpoint"/>
                <i t-if="this.props.node.is_global &amp;&amp; this.props.node.type === 'state'" class="oi me-2 text-info" data-icon="public" title="Global State - Events available in any state"/>
                <t t-esc="this.props.node.label"/>
            </div>
            <div class="o_fsm_node_body">
                <t t-if="this.props.node.type === 'state'">
                    <div t-foreach="this.props.node.events || []" t-as="event" t-key="event.name" class="o_fsm_port_out_wrapper">
                        <span><t t-esc="event.name"/></span>
                        <div class="o_fsm_port o_fsm_port_out"
                             t-att-data-node-id="this.props.node.id"
                             t-att-data-port-name="event.name"
                             t-on-pointerdown="(ev) => this.onPortMouseDown(ev, event.name)"/>
                    </div>
                </t>
                <t t-if="this.props.node.type === 'transition' || this.props.node.type === 'start'">
                    <div t-foreach="Object.keys(this.props.node.outcomes || {})" t-as="outcome" t-key="outcome" class="o_fsm_port_out_wrapper">
                        <span><t t-esc="outcome"/></span>
                        <div class="o_fsm_port o_fsm_port_out"
                             t-att-data-node-id="this.props.node.id"
                             t-att-data-port-name="outcome"
                             t-on-pointerdown="(ev) => this.onPortMouseDown(ev, outcome)"/>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
