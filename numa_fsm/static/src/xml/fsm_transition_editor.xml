<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMTransitionEditor" owl="1">
        <div class="o_fsm_editor_panel">
            <div class="o_fsm_editor_header">
                <h3>Edit <t t-esc="props.node.type === 'start' ? 'Start' : 'Transition'"/></h3>
                <button class="btn-close" t-on-click="props.onClose"/>
            </div>
            <div class="o_fsm_editor_body">
                <div class="mb-3" t-if="props.node.type !== 'start'">
                    <label for="eventName" class="form-label">Event Name</label>
                    <input type="text" class="form-control" id="eventName" t-model="state.eventName"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Code</label>
                    <!-- Fallback to textarea for stability -->
                    <textarea class="form-control" rows="10" style="font-family: monospace;" t-model="state.code" placeholder="# Python code here..."/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Outcomes</label>
                    <div class="text-muted mb-2"><small>Default outcome is always available.</small></div>
                    <div t-foreach="state.outcomes" t-as="outcome" t-key="outcome_index" class="input-group mb-2">
                        <input type="text" class="form-control" placeholder="Outcome Name" t-model="outcome.name"/>
                        <button class="btn btn-outline-danger" t-on-click="() => this.removeOutcome(outcome_index)">
                            <i class="fa fa-trash"/>
                        </button>
                    </div>
                    <button class="btn btn-secondary btn-sm" t-on-click="addOutcome">
                        <i class="fa fa-plus"/> Add Outcome
                    </button>
                </div>
            </div>
            <div class="o_fsm_editor_footer">
                <button class="btn btn-primary" t-on-click="save">Save</button>
                <button class="btn btn-secondary" t-on-click="props.onClose">Cancel</button>
            </div>
        </div>
    </t>
</templates>
