<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMNodeCreator" owl="1">
        <div class="o_fsm_modal">
            <div class="o_fsm_modal_content">
                <div class="o_fsm_modal_header">
                    <h3>Add Node</h3>
                    <button class="btn-close" t-on-click="props.onClose"/>
                </div>
                <div class="o_fsm_modal_body">
                    <div class="d-flex justify-content-around mb-4">
                        <button class="btn btn-outline-primary d-flex flex-column align-items-center p-3"
                                t-att-class="{active: state.type === 'state'}"
                                t-on-click="() => setType('state')">
                            <i class="fa fa-circle-o fa-2x mb-2"/>
                            <span>State</span>
                        </button>
                        <button class="btn btn-outline-secondary d-flex flex-column align-items-center p-3"
                                t-att-class="{active: state.type === 'transition'}"
                                t-on-click="() => setType('transition')">
                            <i class="fa fa-long-arrow-right fa-2x mb-2"/>
                            <span>Transition</span>
                        </button>
                        <button class="btn btn-outline-danger d-flex flex-column align-items-center p-3"
                                t-att-class="{active: state.type === 'end'}"
                                t-on-click="() => setType('end')">
                            <i class="fa fa-stop-circle-o fa-2x mb-2"/>
                            <span>End</span>
                        </button>
                    </div>

                    <div class="mb-3" t-if="state.type === 'state'">
                        <label for="nodeLabel" class="form-label">State Name</label>
                        <input type="text" class="form-control" id="nodeLabel" t-model="state.label" placeholder="e.g. Waiting for Input"/>
                    </div>

                    <div class="mb-3" t-if="state.type === 'transition'">
                        <label for="nodeLabel" class="form-label">Transition Name (Optional)</label>
                        <input type="text" class="form-control" id="nodeLabel" t-model="state.label" placeholder="Auto-generated if empty"/>
                    </div>
                </div>
                <div class="o_fsm_modal_footer">
                    <button class="btn btn-primary" t-on-click="save">Create</button>
                    <button class="btn btn-secondary" t-on-click="props.onClose">Cancel</button>
                </div>
            </div>
        </div>
    </t>
</templates>
