<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMDiagram" owl="1">
        <div class="o_fsm_diagram_container" style="height: 600px; background-color: #f0f0f0; position: relative; overflow: hidden;">
            <div class="o_fsm_diagram_toolbar" style="position: absolute; top: 10px; left: 10px; z-index: 10;">
                <button class="btn btn-primary btn-sm" t-if="state.isDirty" t-on-click="saveData">
                    <i class="fa fa-save"/> Save
                </button>
                <button class="btn btn-secondary btn-sm" t-if="state.isDirty" t-on-click="cancelChanges">
                    <i class="fa fa-times"/> Cancel
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="validateDiagram">
                    <i class="fa fa-check"/> Validate
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="zoomToFit">
                    <i class="fa fa-arrows-alt"/> Zoom to Fit
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="toggleHelp">
                    <i class="fa fa-question-circle"/> Help
                </button>
            </div>
            <!-- ... (resto del template) ... -->
        </div>
    </t>
</templates>
