<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMDiagram" owl="1">
        <div class="o_fsm_diagram_container">
            <div class="o_fsm_diagram_toolbar">
                <button class="btn btn-secondary btn-sm" t-on-click="validateDiagram">
                    <i class="fa fa-check"/> Validate
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="toggleHelp">
                    <i class="fa fa-question-circle"/> Help
                </button>
            </div>
            <div class="o_fsm_diagram_canvas"
                 t-ref="container"
                 t-on-mousedown="onMouseDown"
                 t-on-wheel="onWheel"
                 t-on-dblclick="onDblClick">
                <div class="o_fsm_viewport"
                     t-att-style="'transform: translate(' + state.transform.x + 'px, ' + state.transform.y + 'px) scale(' + state.transform.k + ');'">

                    <svg class="o_fsm_connections">
                        <!-- ... -->
                    </svg>

                    <div class="o_fsm_nodes">
                        <t t-foreach="state.nodes" t-as="node" t-key="node.id">
                            <FSMNode
                                node="node"
                                diagramScale="state.transform.k"
                                t-on-move.stop="onNodeMove"
                                t-on-resize.stop="onNodeResize"
                                t-on-dblclick.stop="() => this.onNodeDblClick(node.id)"
                                t-on-port-mousedown.stop="(ev) => this.onPortMouseDown(ev.detail.event, node, ev.detail.portName)"
                            />
                        </t>
                    </div>
                </div>
            </div>

            <t t-if="state.editingNode">
                <!-- ... -->
            </t>

            <!-- Help Modal -->
            <div t-if="state.showHelp" class="o_fsm_help_modal">
                <div class="o_fsm_help_content">
                    <div class="o_fsm_help_header">
                        <h3>Editor Help</h3>
                        <button class="btn-close" t-on-click="toggleHelp"/>
                    </div>
                    <div class="o_fsm_help_body">
                        <ul>
                            <li><strong>Pan:</strong> Drag the background.</li>
                            <li><strong>Zoom:</strong> Use the mouse wheel.</li>
                            <li><strong>Create Node:</strong> Double-click on the background.</li>
                            <li><strong>Edit Node:</strong> Double-click on a node.</li>
                            <li><strong>Create Connection:</strong> Drag from an output port (right) to an input port (left).</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
