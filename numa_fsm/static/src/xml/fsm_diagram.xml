<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMDiagram" owl="1">
        <div class="o_fsm_diagram_container">
            <!-- ... (toolbar, canvas) ... -->

            <t t-if="state.isCreatingNode">
                <FSMNodeCreator
                    x="state.creatorPos.x"
                    y="state.creatorPos.y"
                    onSave.bind="onNodeCreate"
                    onClose.bind="onNodeCreatorClose"
                />
            </t>

            <t t-if="state.editingNode">
                <!-- ... (editors) ... -->
            </t>

            <!-- ... (help modal) ... -->
        </div>
    </t>
</templates>
