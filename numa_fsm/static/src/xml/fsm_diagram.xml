<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_fsm.FSMDiagram" owl="1">
        <div t-ref="this.containerRef" class="o_fsm_diagram_container o_field_fsm_diagram overflow-hidden">
            <div class="w-100 h-100"
                 tabindex="0"
                 t-on-pointerdown="this.onMouseDown"
                 t-on-dblclick="this.onDblClick"
                 t-on-wheel="this.onWheel">
                <div class="o_fsm_diagram_toolbar d-flex gap-2">
                    <button class="btn btn-secondary shadow-sm" t-on-click="this.zoomToFit" title="Ajustar Vista">
                        <i class="oi" data-icon="expand_content"/>
                    </button>
                    <button class="btn btn-primary shadow-sm" t-on-click="this.onValidateClick" title="Validar Diagrama">
                        <i class="oi" data-icon="check"/> Validar
                    </button>
                    <button class="btn btn-info shadow-sm text-white" t-on-click="this.showHelp" title="Ayuda">
                        <i class="oi" data-icon="help"/> Ayuda
                    </button>
                    <div t-if="this.props.record.data.is_verified" class="badge rounded-pill bg-success d-flex align-items-center px-3 shadow-sm" title="Verificado">
                        <i class="oi me-1" data-icon="security"/> Verificado
                    </div>
                </div>

                <div class="o_fsm_viewport"
                     t-att-style="'transform: translate(' + this.state.transform.x + 'px, ' + this.state.transform.y + 'px) scale(' + this.state.transform.k + ');'">
                    <!-- Connections Layer (SVG) -->
                    <svg class="o_fsm_connections">
                        <t t-if="this.state.dataLoaded">
                            <t t-foreach="this.state.connections" t-as="conn" t-key="conn.id">
                                <g class="o_fsm_connection_group"
                                   t-on-mouseenter="() => this.onElementPointerEnter(conn.id)"
                                   t-on-mouseleave="this.onElementPointerLeave">
                                    <path t-att-d="this.getCurvePath(conn)"
                                          t-att-data-conn-id="conn.id"
                                          t-att-class="{
                                              'o_fsm_connection': true,
                                              'o_fsm_connection_selected': this.state.selectedIds.has(conn.id),
                                              'o_fsm_connection_hover': this.state.hoveredId === conn.id
                                          }"/>
                                    <path t-att-d="this.getCurvePath(conn)"
                                          t-att-data-conn-id="conn.id"
                                          class="o_fsm_connection_hitbox"/>
                                </g>
                            </t>
                            <path t-if="this.state.newConnection"
                                  t-att-d="`M ${Math.round(this.state.newConnection.x1)} ${Math.round(this.state.newConnection.y1)} L ${Math.round(this.state.newConnection.x2)} ${Math.round(this.state.newConnection.y2)}`"
                                  class="o_fsm_new_connection"/>
                        </t>
                    </svg>

                    <!-- Nodes Layer (HTML) -->
                    <div class="o_fsm_nodes">
                        <t t-if="this.state.dataLoaded">
                            <t t-foreach="this.state.nodes" t-as="node" t-key="node.id">
                                <FSMNode node="node"
                                         diagramScale="this.state.transform.k"
                                         selected="this.state.selectedIds.has(node.id)"
                                         hovered="this.state.hoveredId === node.id"
                                         activeNodeId="this.props.activeNodeId"
                                         isConnecting="this.state.connectingTargetId === node.id"
                                         onMove="this.onNodeMove"
                                         onResize="this.onNodeResize"
                                         onPortMouseDown="this.onPortMouseDown"
                                         onNodeDblClick="this.onNodeDblClick"
                                         onMouseEnter="() => this.onElementPointerEnter(node.id)"
                                         onMouseLeave="this.onElementPointerLeave"/>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="d-flex align-items-center justify-content-center h-100 position-absolute w-100" style="top:0; left:0;">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <div class="o_fsm_editors">
                <FSMNodeCreator t-if="this.state.isCreatingNode"
                                x="this.state.creatorPos.x"
                                y="this.state.creatorPos.y"
                                onSave="this.onNodeCreate"
                                onClose="this.onNodeCreatorClose"/>

                <FSMTransitionEditor t-if="this.state.editingNode and (this.state.editingNodeType === 'transition' or this.state.editingNodeType === 'start')"
                                     node="this.state.editingNode"
                                     readonly="this.isReadonly"
                                     onSave="this.onEditorSave"
                                     onClose="this.onEditorClose"/>

                <FSMStateEditor t-if="this.state.editingNode and this.state.editingNodeType === 'state'"
                                node="this.state.editingNode"
                                readonly="this.isReadonly"
                                onSave="this.onEditorSave"
                                onClose="this.onEditorClose"/>
            </div>

            <!-- Help Modal -->
            <div t-if="this.state.showHelp" class="o_fsm_help_modal" t-on-click="this.hideHelp">
                <div class="o_fsm_help_content shadow-lg" t-on-click.stop="">
                    <div class="o_fsm_help_header">
                        <h4 class="mb-0">Manual de Uso - Editor FSM</h4>
                        <button class="btn-close" t-on-click="this.hideHelp"></button>
                    </div>
                    <div class="o_fsm_help_body mt-3">
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="oi text-primary me-2" data-icon="arrow_selector_tool"/> <strong>Click simple:</strong> Seleccionar elemento.</li>
                            <li class="mb-2"><i class="oi text-primary me-2" data-icon="open_with"/> <strong>Arrastrar:</strong> Mover nodos (múltiples si están seleccionados).</li>
                            <li class="mb-2"><i class="oi text-primary me-2" data-icon="add_circle"/> <strong>Doble Click Fondo:</strong> Crear nuevo Nodo/Transición/Fin.</li>
                            <li class="mb-2"><i class="oi text-primary me-2" data-icon="edit"/> <strong>Doble Click Nodo:</strong> Editar propiedades y código.</li>
                            <li class="mb-2"><i class="oi text-primary me-2" data-icon="link"/> <strong>Arrastrar desde Puerto:</strong> Crear nueva conexión.</li>
                            <li class="mb-2"><i class="oi text-danger me-2" data-icon="delete"/> <strong>Supr / Backspace:</strong> Borrar elementos seleccionados.</li>
                            <li class="mb-2"><i class="oi text-success me-2" data-icon="undo"/> <strong>Ctrl + Z:</strong> Deshacer último cambio.</li>
                            <li class="mb-2"><i class="oi text-primary me-2" data-icon="zoom_in"/> <strong>Rueda Ratón:</strong> Zoom In/Out.</li>
                        </ul>
                    </div>
                    <div class="text-end mt-3">
                        <button class="btn btn-primary" t-on-click="this.hideHelp">Entendido</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
