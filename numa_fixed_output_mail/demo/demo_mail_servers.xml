<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_mail_server_alpha" model="ir.mail_server">
        <field name="name">Alpha SMTP</field>
        <field name="smtp_host">smtp.alpha.example.com</field>
        <field name="smtp_port">587</field>
        <field name="smtp_encryption">starttls</field>
        <field name="smtp_user">ventas@alpha.example.com</field>
        <field name="smtp_pass">alpha-secret</field>
        <field name="company_id" ref="numa_fixed_output_mail.demo_company_alpha"/>
        <field name="force_smtp_sender">1</field>
    </record>

    <record id="demo_mail_server_beta" model="ir.mail_server">
        <field name="name">Beta SMTP</field>
        <field name="smtp_host">smtp.beta.example.com</field>
        <field name="smtp_port">587</field>
        <field name="smtp_encryption">starttls</field>
        <field name="smtp_user">ventas@beta.example.com</field>
        <field name="smtp_pass">beta-secret</field>
        <field name="company_id" ref="numa_fixed_output_mail.demo_company_beta"/>
        <field name="force_smtp_sender">0</field>
    </record>
</odoo>
