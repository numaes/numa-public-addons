<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve" >

    <!--
      Progress bar of a background job.

      The bar is built ONCE. There used to be one copy per state, each with a fixed-width
      block, so it showed up all grey and never moved. The filled part now has the width of
      the percentage and takes its colour from the state; what changes with the state is
      only the cancel button and the error message.
    -->
    <t t-name="numa_background_job.bj_spinner" owl="1" >
        <div class="bj_spinner">
            <div >
                <p t-out="this.state_msg"/>
            </div>

            <div class="o_bjprogressbar">
                <div class="o_bjprogressbar_indicator"
                     t-att-class="'o_bjprogressbar_' + this.spinner_state"
                     t-attf-style="width: {{ this.progress_pct }}%;"/>
                <div class="o_bjprogressbar_frame">
                    <span class="o_bjprogressbar_value" t-out="this.progress_pct + ' %'"/>
                </div>
            </div>

            <div t-if="this.spinner_state == 'init' || this.spinner_state == 'started'"
                 class="o_bjprogressbar_abort" >
                <button t-on-click="() => this.click_abort()">
                    Cancel
                </button>
            </div>

            <div class="o_bjprogressbar_message" >
                <span t-out="this.current_status"/>
            </div>
            <div t-if="this.error_msg" class="o_bjprogressbar_error" >
                <span t-out="this.error_msg"/>
            </div>
        </div>
    </t>

</templates>
