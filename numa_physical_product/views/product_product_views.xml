<?xml version="1.0"?>

<odoo>
    <data>
        <!-- Products variant Form View -->
        <record id="product_normal_form_view" model="ir.ui.view">
            <field name="name">product.normal.form</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//group[@name='inventory']/group[@name='computation']" position="inside">
                    <field name="variant_width" invisible="1"/>
                    <field name="variant_length" invisible="1" />
                    <field name="variant_height" invisible="1" />
                    <field name="variant_surface" invisible="1" />
                    <field name="variant_volume" invisible="1" />
                    <field name="variant_weight" invisible="1" />
                    <field name="variant_weight_factor" invisible="1" />
                    <separator string="Own Magnitudes"/>
                    <label for="variant_length_set"
                           string="A magnitude is inherited from the product template until this variant states its own. Untick to inherit again."/>
                    <field name="variant_length_set" />
                    <field name="variant_width_set" />
                    <field name="variant_height_set" />
                    <field name="variant_surface_set" />
                    <field name="variant_volume_set" />
                    <field name="variant_weight_set" />
                    <field name="variant_weight_factor_set" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
