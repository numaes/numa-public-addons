<?xml version="1.0"?>

<odoo>
    <data>
        <!-- Products template Form View -->
        <record id="product_template_form_view" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='inventory']/group[@name='group_lots_and_weight']" position="after">
                    <group name="physical_characteristics" string="Physical Characteristics" invisible="type not in ['product', 'consu']">
                        <field name="product_width" />
                        <field name="product_length" />
                        <field name="product_height" />
                        <field name="surface" />
                        <field name="volume" />
                        <field name="weight" />
                    </group>
                    <group name="computation">
                        <separator string="Price Computation"/>
                        <field name="price_base" />
                        <separator string="Weight Computation"/>
                        <field name="weight_kind" />
                        <field name="weight_factor" invisible="weight_kind == 'normal'"/>
                   </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
