#. module: numa_web_relative_dates
#. odoo-javascript
#: code:addons/numa_web_relative_dates/static/src/within_hint.xml:0
msgid ""
"This filter is relative: the range is counted from today, and it is "
"recalculated every time the filter runs. Saving it as a favourite keeps it "
"relative — it will not freeze on today's date."
msgstr ""
"Este filtro es relativo: el rango se cuenta desde hoy y se recalcula cada vez "
"que se usa. Si lo guardás como favorito sigue siendo relativo — no queda "
"congelado en la fecha de hoy."
