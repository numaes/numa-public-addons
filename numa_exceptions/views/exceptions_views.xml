<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="exceptions_form_view" model="ir.ui.view">
        <field name="name">base.general_exception.form</field>
        <field name="model">base.general_exception</field>
        <field name="arch" type="xml">
            <form string="Exception">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_frames" type="object" icon="format_list_bulleted">
                            <field name="frames_count" string="Frames" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="General">
                        <field name="service"/>
                        <field name="exception"/>
                        <field name="method"/>
                        <field name="params"/>
                        <field name="timestamp"/>
                        <field name="do_not_purge"/>
                        <field name="user"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="exceptions_list_view" model="ir.ui.view">
        <field name="name">base.general_exception.list</field>
        <field name="model">base.general_exception</field>
        <field name="arch" type="xml">
            <list string="Exception" create="0" edit="0">
                <field name="user"/>
                <field name="name"/>
                <field name="timestamp"/>
                <field name="service"/>
                <field name="method"/>
            </list>
        </field>
    </record>

    <record id="exceptions_search_view" model="ir.ui.view">
        <field name="name">base.general_exception.search</field>
        <field name="model">base.general_exception</field>
        <field name="arch" type="xml">
            <search string="Exceptions">
                <field name="name"/>
                <field name="user"/>
                <field name="timestamp"/>
                <field name="service"/>
                <filter string="Do not purge" name="do_not_purge" domain="[('do_not_purge', '=', True)]"/>
                <group name="group_by">
                    <filter string="Service" name="group_by_service" context="{'group_by': 'service'}"/>
                    <filter string="User" name="group_by_user" context="{'group_by': 'user'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="exc_frame_form_view" model="ir.ui.view">
        <field name="name">base.frame.form</field>
        <field name="model">base.frame</field>
        <field name="arch" type="xml">
            <form string="Frame">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="file_name"/>
                        </h2>
                    </div>
                    <group string="General">
                        <field name="gexception" invisible="1"/>
                        <field name="line_number"/>
                        <field name="src_code"/>
                        <field name="locals" readonly="1">
                            <list string="Locals">
                                <field name="sequence" column_invisible="1"/>
                                <field name="name"/>
                                <field name="value"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="exc_frame_list_view" model="ir.ui.view">
        <field name="name">base.frame.list</field>
        <field name="model">base.frame</field>
        <field name="arch" type="xml">
            <list string="Frames" create="0" edit="0">
                <field name="gexception"/>
                <field name="file_name"/>
                <field name="line_number"/>
            </list>
        </field>
    </record>
</odoo>
