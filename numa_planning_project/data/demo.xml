<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Planning Scenario -->
        <record id="scenario_validation" model="numa.planning.scenario">
            <field name="name">Validation Sandbox</field>
            <field name="is_official" eval="True"/>
            <field name="is_active" eval="True"/>
        </record>

        <!-- 2. Planning Resource -->
        <record id="resource_consultant" model="numa.planning.resource">
            <field name="name">Lead Consultant</field>
            <field name="capacity" eval="1.0"/>
        </record>

        <!-- 3. Standard Odoo Project -->
        <record id="project_validation" model="project.project">
            <field name="name">Numa Validation Protocol</field>
            <field name="allow_task_dependencies" eval="True"/>
        </record>

        <!-- 4. Chained Tasks: A -> B -> C -->
        <record id="task_a" model="project.task">
            <field name="name">Task A: Requirements Analysis</field>
            <field name="project_id" ref="project_validation"/>
            <field name="planned_hours" eval="8.0"/>
        </record>

        <record id="task_b" model="project.task">
            <field name="name">Task B: Technical Design</field>
            <field name="project_id" ref="project_validation"/>
            <field name="planned_hours" eval="16.0"/>
            <field name="depend_on_ids" eval="[(4, ref('task_a'))]"/>
        </record>

        <record id="task_c" model="project.task">
            <field name="name">Task C: Integration Testing</field>
            <field name="project_id" ref="project_validation"/>
            <field name="planned_hours" eval="4.0"/>
            <field name="depend_on_ids" eval="[(4, ref('task_b'))]"/>
        </record>

        <!-- 5. Default Allocations to trigger date calculation -->
        <!-- Note: We create initial allocations to prove the bridge maps dates back to Odoo -->
        <record id="alloc_a" model="numa.planning.allocation">
            <field name="node_id" ref="task_a"/>
            <field name="resource_id" ref="resource_consultant"/>
            <field name="scenario_id" ref="scenario_validation"/>
            <field name="start_date" eval="(datetime.now()).strftime('%Y-%m-%d 08:00:00')"/>
            <field name="end_date" eval="(datetime.now()).strftime('%Y-%m-%d 17:00:00')"/>
            <field name="pln_state">reserved</field>
        </record>
    </data>
</odoo>
