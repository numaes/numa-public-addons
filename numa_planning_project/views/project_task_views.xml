<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherited" model="ir.ui.view">
        <field name="name">project.task.form.inherited</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Inject Planning Engine Tab -->
            <xpath expr="//notebook" position="inside">
                <page name="planning_engine" string="Planning Engine">
                    <group name="engine_control" string="Engine Control">
                        <div class="d-flex gap-2">
                            <button name="pln_action_auto_schedule" type="object" string="Auto Schedule" class="btn-primary" icon="fa-magic"/>
                            <button name="action_freeze_baseline" type="object" string="Freeze Baseline" class="btn-secondary" icon="fa-snowflake-o"/>
                            <button name="action_simulate" type="object" string="Simulate" class="btn-secondary" icon="fa-flask"/>
                        </div>
                    </group>
                    <group>
                        <group name="metrics" string="Metrics">
                            <field name="pln_calc_start" readonly="1"/>
                            <field name="pln_calc_end" readonly="1"/>
                            <field name="pln_effort_hours" widget="float_time" readonly="1"/>
                            <field name="pln_is_critical" readonly="1"/>
                            <field name="pln_total_float" readonly="1"/>
                        </group>
                        <group name="constraints" string="Constraints">
                            <field name="pln_constraint_type"/>
                            <field name="pln_constraint_date"/>
                            <field name="pln_duration_type"/>
                        </group>
                    </group>
                    <group name="allocations" string="Resource Allocations">
                        <field name="pln_allocation_ids" nolabel="1" context="{'default_node_id': id}">
                            <list editable="bottom">
                                <field name="scenario_id" domain="[('is_active', '=', True)]"/>
                                <field name="resource_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="pln_state"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

            <!-- Add Smart Button for Allocations -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="pln_get_allocations_view" type="object" class="oe_stat_button" icon="fa-tasks">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Planning</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
