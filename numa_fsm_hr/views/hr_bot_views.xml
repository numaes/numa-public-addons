<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- HR Bot List View -->
        <record id="hr_bot_view_list" model="ir.ui.view">
            <field name="name">hr.bot.list</field>
            <field name="model">hr.bot</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="numa_fsm.definition_list_view"/>
        </record>

        <!-- HR Bot Form View -->
        <record id="hr_bot_view_form" model="ir.ui.view">
            <field name="name">hr.bot.form</field>
            <field name="model">hr.bot</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="numa_fsm.definition_form_view"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <span>"Bot Name"</span>
                    <newline/>
                </field>
            </field>
        </record>

        <!-- Action for HR Bot -->
        <record model="ir.actions.act_window" id="action_hr_bot">
            <field name="name">HR Bots</field>
            <field name="res_model">hr.bot</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type', '=', 'hr_bot')]</field>
            <field name="context">{'default_type': 'hr_bot'}</field>
        </record>
    </data>
</odoo>
