<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- FSM Definition -->

        <record model="ir.actions.act_window" id="definition_action">
            <field name="name">HR Workflows definitions</field>
            <field name="res_model">fsm.definition</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'HR_Workflow')]</field>
            <field name="context">{'default_type': 'HR_Workflow'}</field>
        </record>

        <!-- HR Workflows -->

        <record model="ir.ui.view" id="hr_workflow_form_view">
            <field name="name">HR Workflow form</field>
            <field name="model">hr.workflow</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="numa_fsm.instance_form_view"/>
            <field name="arch" type="xml">
                <field name="state" position="before">
                    <button name="action_confirm_manual_operation" type="object"
                            string="Confirm manual operation"
                            invisible="state != 'running'"/>
                </field>
                <field name="definition_id" position="attributes">
                    <attribute name="domain">[('type', '=', 'HR_Workflow')]</attribute>
                    <attribute name="context">{'default_type': 'HR_Workflow'}</attribute>
                </field>
                <notebook position="inside">
                    <page name="relations" string="Relations">
                        <group>
                            <field name="employee_id" />
                            <field name="partner_id" />
                            <field name="reply_to" />
                        </group>
                    </page>
                </notebook>
                <xpath expr="//page[@name='status']/group" position="inside">
                    <field name="manual_operation_needed" />
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="hr_workflow_list_view">
            <field name="name">HR Workflow list view</field>
            <field name="model">hr.workflow</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="numa_fsm.instance_list_view"/>
            <field name="arch" type="xml">
                <field name="definition_id" position="after">
                    <field name="employee_id" />
                    <field name="partner_id" />
                    <field name="manual_operation_needed" />
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="hr_workflow_search_view">
            <field name="name">HR Workflow search view</field>
            <field name="model">hr.workflow</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="numa_fsm.instance_search_view"/>
            <field name="arch" type="xml">
                <field name="state" position="after">
                    <field name="employee_id" />
                    <field name="partner_id" />
                    <field name="manual_operation_needed" />
                </field>
                <xpath expr="//group[@name='group_by']" position="inside">
                    <filter string="Employee" name="group_employee_id" context="{'group_by': 'employee_id'}"/>
                    <filter string="Partner" name="group_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Manual Op Needed" name="group_manual_op" context="{'group_by': 'manual_operation_needed'}"/>
                </xpath>
            </field>
        </record>

        <record model="ir.actions.act_window" id="hr_workflow_action">
            <field name="name">HR Workflows</field>
            <field name="res_model">hr.workflow</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('definition_id.type', '=', 'HR_Workflow')]</field>
            <field name="context">{'default_type': 'HR_Workflow'}</field>
        </record>

    </data>
</odoo>
