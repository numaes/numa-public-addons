<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- [20.0] `system.ping` became `system_ping`: a dot cannot be part of a
             topic name, because the dispatcher builds a method name out of it. The
             module shipped the dotted name, its own constraint rejected it, and the
             module could not install. -->
        <!-- Test Ping Topic -->
        <record id="topic_test_ping" model="numa.fsm.topic">
            <field name="name">test_ping</field>
            <field name="description">Test topic for ping/pong communication between FSM instances.</field>
            <field name="payload_example">{"message": "ping", "timestamp": "2024-01-01T00:00:00", "sender_id": 123}</field>
            <field name="active">True</field>
        </record>

        <!-- System Ping Topic for Diagnostics -->
        <record id="topic_system_ping" model="numa.fsm.topic">
            <field name="name">system_ping</field>
            <field name="description">Diagnostic topic: publishing it and seeing a PONG in the subscriber's chatter is what proves the pub/sub circuit works end to end.</field>
            <field name="payload_example">{"sender": "fsm_x", "timestamp": "2024-01-01T12:00:00"}</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
