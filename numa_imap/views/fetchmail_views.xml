<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_message_form" model="ir.ui.view">
        <field name="name">mail.message.form.fetchmail</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.mail_message_view_form"/>
        <field name="arch" type="xml">
            <field name="mail_server_id" position="after">
                <field name="fetchmail_server_id"/>
            </field>
        </field>
    </record>

    <record id="view_email_server_form" model="ir.ui.view">
        <field name="name">fetchmail.server.form.numa.uid</field>
        <field name="model">fetchmail.server</field>
        <!-- [20.0] The view moved with the model: it is `mail.view_email_server_form` now. -->
        <field name="inherit_id" ref="mail.view_email_server_form"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="initially_from"/>
                <field name="last_uid"/>
                <field name="last_uid_validity" groups="base.group_no_one"/>
            </field>
        </field>
    </record>

</odoo>
