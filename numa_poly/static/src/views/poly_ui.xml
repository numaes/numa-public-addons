<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="numa_poly.PolySubtypeDialog">
        <Dialog title="this.title" size="'md'" footer="false">
            <div class="list-group">
                <t t-foreach="this.props.subtypes" t-as="subtype" t-key="subtype.model">
                    <button type="button"
                            class="list-group-item list-group-item-action o_poly_subtype"
                            t-att-data-model="subtype.model"
                            t-on-click="() => this.pick(subtype)">
                        <t t-out="subtype.name"/>
                    </button>
                </t>
            </div>
        </Dialog>
    </t>
</templates>
