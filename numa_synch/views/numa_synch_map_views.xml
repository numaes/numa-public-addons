<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tree View for numa.synch.map -->
        <record id="view_numa_synch_map_tree" model="ir.ui.view">
            <field name="name">numa.synch.map.tree</field>
            <field name="model">numa.synch.map</field>
            <field name="arch" type="xml">
                <list string="Synchronization Identity Mapping" >
                    <field name="model_name"/>
                    <field name="local_id"/>
                    <field name="remote_id"/>
                    <field name="node_token"/>
                    <field name="last_sync_date"/>
                </list>
            </field>
        </record>

        <!-- Form View for numa.synch.map -->
        <record id="view_numa_synch_map_form" model="ir.ui.view">
            <field name="name">numa.synch.map.form</field>
            <field name="model">numa.synch.map</field>
            <field name="arch" type="xml">
                <form string="Synchronization Identity Mapping">
                    <sheet>
                        <group>
                            <group>
                                <field name="model_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="model_name" readonly="1"/>
                            </group>
                            <group>
                                <field name="local_id"/>
                                <field name="remote_id"/>
                                <field name="node_token"/>
                                <field name="last_sync_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for numa.synch.map -->
        <record id="view_numa_synch_map_search" model="ir.ui.view">
            <field name="name">numa.synch.map.search</field>
            <field name="model">numa.synch.map</field>
            <field name="arch" type="xml">
                <search string="Search Identity Mapping">
                    <field name="model_name"/>
                    <field name="local_id"/>
                    <field name="remote_id"/>
                    <field name="node_token"/>
                    <separator/>
                    <filter string="Recent Sync" name="recent_sync" domain="[('last_sync_date', '!=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Model" name="group_by_model" context="{'group_by': 'model_name'}"/>
                        <filter string="Node Token" name="group_by_node" context="{'group_by': 'node_token'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for numa.synch.map -->
        <record id="action_numa_synch_map" model="ir.actions.act_window">
            <field name="name">Synchronization Identity Mapping</field>
            <field name="res_model">numa.synch.map</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create identity mappings between local and remote records
                </p>
                <p>
                    This table maps local record IDs to remote record IDs for synchronization purposes.
                </p>
            </field>
        </record>
    </data>
</odoo>
