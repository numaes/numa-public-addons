<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tree View for numa.synch.rule -->
        <record id="view_numa_synch_rule_tree" model="ir.ui.view">
            <field name="name">numa.synch.rule.tree</field>
            <field name="model">numa.synch.rule</field>
            <field name="arch" type="xml">
                <tree string="Synchronization Rules" decoration-muted="not active">
                    <field name="name"/>
                    <field name="model_name"/>
                    <field name="direction"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Form View for numa.synch.rule -->
        <record id="view_numa_synch_rule_form" model="ir.ui.view">
            <field name="name">numa.synch.rule.form</field>
            <field name="model">numa.synch.rule</field>
            <field name="arch" type="xml">
                <form string="Synchronization Rule">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="model_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="model_name" readonly="1"/>
                                <field name="direction"/>
                            </group>
                        </group>
                        <group string="Domain Filter">
                            <field name="domain_filter" 
                                   widget="domain" 
                                   options="{'model': model_id.model}"
                                   placeholder="e.g., [('active', '=', True)]"/>
                            <div class="alert alert-info" role="alert">
                                <p>
                                    <strong>Domain Filter:</strong> Define which records should be synchronized.
                                    Use Odoo domain syntax. Example: <code>[('active', '=', True), ('state', '=', 'done')]</code>
                                </p>
                                <p>
                                    The domain will be automatically combined with a write_date filter
                                    during delta synchronization to only sync modified records.
                                </p>
                            </div>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for numa.synch.rule -->
        <record id="view_numa_synch_rule_search" model="ir.ui.view">
            <field name="name">numa.synch.rule.search</field>
            <field name="model">numa.synch.rule</field>
            <field name="arch" type="xml">
                <search string="Search Synchronization Rules">
                    <field name="name"/>
                    <field name="model_name"/>
                    <field name="direction"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="Bidirectional" name="bidirectional" domain="[('direction', '=', 'bidirectional')]"/>
                    <filter string="Outgoing" name="outgoing" domain="[('direction', '=', 'outgoing')]"/>
                    <filter string="Incoming" name="incoming" domain="[('direction', '=', 'incoming')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Model" name="group_by_model" context="{'group_by': 'model_name'}"/>
                        <filter string="Direction" name="group_by_direction" context="{'group_by': 'direction'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for numa.synch.rule -->
        <record id="action_numa_synch_rule" model="ir.actions.act_window">
            <field name="name">Synchronization Rules</field>
            <field name="res_model">numa.synch.rule</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create synchronization rules
                </p>
                <p>
                    Define which records should be synchronized and in which direction.
                    Use domain filters to specify exactly which records to include.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_numa_synch_root"
                  name="Synchronization"
                  sequence="100"
                  web_icon="numa_synch,static/description/icon.png"/>

        <menuitem id="menu_numa_synch_rules"
                  name="Synchronization Rules"
                  parent="menu_numa_synch_root"
                  action="action_numa_synch_rule"
                  sequence="10"/>

        <menuitem id="menu_numa_synch_mapping"
                  name="Identity Mapping"
                  parent="menu_numa_synch_root"
                  action="action_numa_synch_map"
                  sequence="20"/>
    </data>
</odoo>
