<?xml version="1.0"?>
<odoo>
    <data>

        <record id="view_picking_form" model="ir.ui.view">
            <field name="name">stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="backorder_id" position="after">
                    <field name="picking_weight"/>
                    <field name="picking_volume"/>
                </field>

                <!-- [20.0] The operations page holds `move_ids`; `move_ids_without_package`
                     is gone, and so is the `lot_ids` column the insert hung off. The
                     anchor is the quantity, which is what these numbers qualify. -->
                <xpath expr="//page[@name='operations']//field[@name='move_ids']//list//field[@name='quantity']" position="after">
                    <field name="unit_weight" column_invisible="True"/>
                    <field name="unit_surface" column_invisible="True"/>
                    <field name="unit_volume" column_invisible="True"/>
                    <field name="total_weight" readonly="1" force_save="1" optional="hide"/>
                    <field name="total_volume" readonly="1" force_save="1" optional="hide"/>
                </xpath>

            </field>
        </record>

        <record id="view_move_list" model="ir.ui.view">
            <field name="name">stock.move.list</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_tree"/>
            <field name="arch" type="xml">
                <field name="uom_id" position="after">
                    <field name="total_weight" optional="hide"/>
                    <field name="total_volume" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_stock_move_line_operation_list" model="ir.ui.view">
            <field name="name">stock.move.line.operations.list</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">
                <field name="uom_id" position="after">
                    <field name="unit_weight" readonly="1" force_save="1" optional="hide"/>
                    <field name="unit_surface" column_invisible="True"/>
                    <field name="unit_volume" column_invisible="True"/>
                    <field name="total_weight" optional="hide"/>
                    <field name="total_volume" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_stock_move_line_detailed_operation_list" model="ir.ui.view">
            <field name="name">stock.move.line.operations.list</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <field name="uom_id" position="after">
                    <field name="unit_weight" readonly="1" force_save="1" optional="hide"/>
                    <field name="unit_surface" column_invisible="True"/>
                    <field name="unit_volume" column_invisible="True"/>
                    <field name="total_weight" optional="hide"/>
                    <field name="total_volume" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_move_list_receipt_picking" model="ir.ui.view">
            <field name="name">stock.move.list2</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_tree_receipt_picking"/>
            <field name="arch" type="xml">
                <field name="uom_id" position="after">
                    <field name="unit_weight" optional="hide"/>
                    <field name="unit_volume" optional="hide"/>
                    <field name="total_weight" optional="hide"/>
                    <field name="total_volume" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_move_line_list" model="ir.ui.view">
            <field name="name">stock.move.line.list</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <field name="reference" position="after">
                    <field name="partner_id" readonly="1" force_save="1"/>
                    <field name="sale_order_id" readonly="1" force_save="1"/>
                </field>
                <field name="uom_id" position="after">
                    <field name="unit_weight" readonly="1" force_save="1" optional="hide"/>
                    <field name="unit_surface" column_invisible="True"/>
                    <field name="unit_volume" column_invisible="True"/>
                    <field name="total_weight" optional="hide"/>
                    <field name="total_volume" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_move_line_form" model="ir.ui.view">
            <field name="name">stock.move.line.form</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <field name="reference" position="after">
                    <field name="partner_id" readonly="1" force_save="1"/>
                    <field name="sale_order_id" readonly="1" force_save="1"/>
                </field>
                <field name="lot_name" position="after">
                    <field name="unit_weight" />
                    <field name="unit_surface" />
                    <field name="unit_volume" />
                    <field name="total_weight"/>
                    <field name="total_volume"/>
                </field>
            </field>
        </record>

        <record id="view_physical_move_pivot" model="ir.ui.view">
            <field name="name">stock.physical.move.pivot</field>
            <field name="model">stock.move.line</field>
            <field name="arch" type="xml">
                <pivot string="Stock Moves Analysis" sample="1">
                    <field name="product_id" type="row"/>
                    <field name="location_dest_id" groups="stock.group_stock_multi_locations" type="row"/>
                    <field name="quantity_product_uom" type="measure"/>
                    <field name="total_weight" type="measure"/>
                </pivot>
            </field>
        </record>

    </data>
</odoo>
