<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- 
            Note: This cron is kept for backward compatibility but is now optional.
            Each connection creates its own cron job dynamically based on its configuration.
            This global cron can be disabled if all connections have their own cron jobs.
        -->
        <record id="ir_cron_sync_slave" model="ir.cron">
            <field name="name">Synchronize with Master (Legacy - All Connections)</field>
            <field name="model_id" ref="model_numa_synch_connection"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_all_connections()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
