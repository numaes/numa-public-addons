<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tree View for numa.synch.connection -->
        <record id="view_numa_synch_connection_tree" model="ir.ui.view">
            <field name="name">numa.synch.connection.tree</field>
            <field name="model">numa.synch.connection</field>
            <field name="arch" type="xml">
                <list string="Synchronization Connections" decoration-muted="not active">
                    <field name="name"/>
                    <field name="master_url"/>
                    <field name="slave_token"/>
                    <field name="last_sync_date"/>
                    <field name="sync_interval_number"/>
                    <field name="sync_interval_type"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form View for numa.synch.connection -->
        <record id="view_numa_synch_connection_form" model="ir.ui.view">
            <field name="name">numa.synch.connection.form</field>
            <field name="model">numa.synch.connection</field>
            <field name="arch" type="xml">
                <form string="Synchronization Connection">
                    <header>
                        <button name="action_test_connection"
                                type="object"
                                string="Test Connection"
                                class="btn-primary"
                                icon="fa-plug"/>
                        <button name="action_run_sync"
                                type="object"
                                string="Run Sync Now"
                                class="btn-secondary"
                                icon="fa-refresh"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="slave_token" readonly="1"/>
                                <field name="last_sync_date" readonly="1"/>
                            </group>
                        </group>
                        <group string="Master Server Configuration">
                            <group>
                                <field name="master_url" placeholder="https://my-central-odoo.com"/>
                                <field name="master_db"/>
                            </group>
                            <group>
                                <field name="api_key" password="True"/>
                            </group>
                        </group>
                        <group string="Synchronization Settings">
                            <group>
                                <field name="batch_size"/>
                            </group>
                            <group>
                                <field name="sync_interval_number"/>
                                <field name="sync_interval_type"/>
                            </group>
                        </group>
                        <group string="Scheduling">
                            <group>
                                <field name="use_scheduled_time"/>
                                <field name="sync_schedule_time" 
                                       attrs="{'invisible': [('use_scheduled_time', '=', False)], 
                                               'required': [('use_scheduled_time', '=', True)]}"/>
                            </group>
                            <group>
                                <field name="cron_id" readonly="1"/>
                            </group>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <p>
                                <strong>Batch Size:</strong> Number of records to send per HTTP request.
                                Larger batches are more efficient but may timeout on slow connections.
                                Recommended: 50-200 records.
                            </p>
                            <p>
                                <strong>Sync Interval:</strong> How often to run synchronization automatically.
                                If "Use Scheduled Time" is enabled, synchronization will run at the specified
                                time each day (or at the interval if less than 24 hours).
                            </p>
                            <p>
                                <strong>Scheduled Time:</strong> Time in 24-hour format (e.g., 14.5 = 14:30).
                                Only used if "Use Scheduled Time" is enabled.
                            </p>
                        </div>
                        <div class="alert alert-warning" role="alert">
                            <p>
                                <strong>Slave Token:</strong> This UUID uniquely identifies this Slave node to the Master.
                                It is generated automatically and cannot be changed. Make sure to keep it secure.
                            </p>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for numa.synch.connection -->
        <record id="view_numa_synch_connection_search" model="ir.ui.view">
            <field name="name">numa.synch.connection.search</field>
            <field name="model">numa.synch.connection</field>
            <field name="arch" type="xml">
                <search string="Search Synchronization Connections">
                    <field name="name"/>
                    <field name="master_url"/>
                    <field name="slave_token"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Action for numa.synch.connection -->
        <record id="action_numa_synch_connection" model="ir.actions.act_window">
            <field name="name">Synchronization Connections</field>
            <field name="res_model">numa.synch.connection</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a connection to the Master server
                </p>
                <p>
                    Configure the connection details to synchronize this Slave node
                    with the Master server. The Slave Token is automatically generated
                    and uniquely identifies this node.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_numa_synch_slave_connection"
                  name="Slave Connections"
                  parent="numa_synch.menu_numa_synch_root"
                  action="action_numa_synch_connection"
                  sequence="30"/>
    </data>
</odoo>
