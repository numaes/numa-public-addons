<?xml version="1.0"?>
<odoo>
    <data>

        <record id="product_attribute_rule_view_list" model="ir.ui.view">
            <field name="name">product.attribute.rule.list</field>
            <field name="model">product.attribute.rule</field>
            <field name="arch" type="xml">
                <list string="Configuration Rules">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="product_tmpl_id"/>
                    <field name="condition_value_ids" widget="many2many_tags"/>
                    <field name="effect"/>
                    <field name="effect_value_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="product_attribute_rule_view_form" model="ir.ui.view">
            <field name="name">product.attribute.rule.form</field>
            <field name="model">product.attribute.rule</field>
            <field name="arch" type="xml">
                <form string="Configuration Rule">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="product_tmpl_id"
                                   placeholder="Leave empty to apply everywhere"/>
                            <field name="active"/>
                        </group>
                        <group string="When all of">
                            <field name="condition_value_ids" nolabel="1"
                                   widget="many2many_tags"/>
                        </group>
                        <group string="Then">
                            <field name="effect"/>
                            <field name="effect_value_ids" nolabel="1"
                                   widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="message"
                                   placeholder="Shown when the rule rejects a configuration"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_attribute_rule_action" model="ir.actions.act_window">
            <field name="name">Configuration Rules</field>
            <field name="res_model">product.attribute.rule</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="product_attribute_rule_menu"
                  name="Configuration Rules"
                  parent="sale.prod_config_main"
                  action="product_attribute_rule_action"
                  sequence="20"/>

    </data>
</odoo>
