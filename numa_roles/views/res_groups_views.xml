<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            [20.0] Rebuilt. The previous version inherited pages named `users`,
            `view_access`, `rule_groups`, `menu_access` and `implied_ids`, none of which
            exist in Odoo 20's group form (they are `user_ids`, `inherit_groups`,
            `access_rights` and `menus`), and it hid them with `attrs="{'invisible': …}"`,
            which Odoo removed in 17.0 and rejects outright in 20.0. So this view could
            not load, and neither could the module.

            It is also much smaller now. Hiding half the standard form per type was a lot
            of surface for little gain: the type is stated, the fields that belong to it
            are shown, and the rest of the form stays where an administrator expects it.
        -->
        <record id="view_groups_form_numa_roles" model="ir.ui.view">
            <field name="name">res.groups.form.numa_roles</field>
            <field name="model">res.groups</field>
            <field name="inherit_id" ref="base.view_groups_form"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="numa_type" widget="radio" options="{'horizontal': true}"/>
                </field>
                <xpath expr="//field[@name='comment']" position="before">
                    <field name="technical_code" invisible="numa_type != 'permission'"
                           readonly="technical_code != False"
                           placeholder="perm_approve_discount"/>
                    <field name="permission_count" invisible="numa_type != 'role'"/>
                    <field name="is_template"/>
                </xpath>
                <!-- A role bundles permissions; a permission bundles permissions or
                     system groups, never roles. The domain says it in the picker, the
                     constraint says it on save. -->
                <xpath expr="//field[@name='implied_ids']" position="attributes">
                    <attribute name="domain">
                        [('numa_type', 'in',
                          numa_type == 'permission' and ['permission', 'system'] or
                          ['role', 'permission', 'system'])]
                    </attribute>
                </xpath>
            </field>
        </record>

        <record id="view_groups_list_numa_roles" model="ir.ui.view">
            <field name="name">res.groups.list.numa_roles</field>
            <field name="model">res.groups</field>
            <field name="inherit_id" ref="base.view_groups_list"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="numa_type"/>
                    <field name="technical_code" optional="show"/>
                </field>
            </field>
        </record>

        <record id="view_groups_search_numa_roles" model="ir.ui.view">
            <field name="name">res.groups.search.numa_roles</field>
            <field name="model">res.groups</field>
            <field name="inherit_id" ref="base.view_groups_search"/>
            <field name="arch" type="xml">
                <!-- The search view has `full_name`, not `name`. -->
                <field name="full_name" position="after">
                    <field name="technical_code"/>
                    <filter string="Roles" name="numa_roles"
                            domain="[('numa_type', '=', 'role')]"/>
                    <filter string="Permissions" name="numa_permissions"
                            domain="[('numa_type', '=', 'permission')]"/>
                    <separator/>
                </field>
            </field>
        </record>

        <record id="action_numa_roles" model="ir.actions.act_window">
            <field name="name">Roles</field>
            <field name="res_model">res.groups</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('numa_type', '=', 'role')]</field>
            <field name="context">{'default_numa_type': 'role'}</field>
        </record>

        <record id="action_numa_permissions" model="ir.actions.act_window">
            <field name="name">Permissions</field>
            <field name="res_model">res.groups</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('numa_type', '=', 'permission')]</field>
            <field name="context">{'default_numa_type': 'permission'}</field>
        </record>
    </data>
</odoo>
