<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Example Permission 1: View Dashboard -->
        <record id="perm_view_dashboard" model="res.groups">
            <field name="name">Ver Dashboard</field>
            <field name="numa_type">permission</field>
            <field name="technical_code">perm_view_dashboard</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="is_template">True</field>
            <field name="comment">Permite al usuario ver el dashboard principal del sistema.</field>
        </record>

        <!-- Example Permission 2: Export Data -->
        <record id="perm_export_data" model="res.groups">
            <field name="name">Exportar Datos</field>
            <field name="numa_type">permission</field>
            <field name="technical_code">perm_export_data</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="is_template">True</field>
            <field name="comment">Permite al usuario exportar datos a Excel, CSV u otros formatos.</field>
        </record>

        <!-- Example Role: Data Analyst -->
        <!-- This role includes both example permissions -->
        <record id="role_data_analyst" model="res.groups">
            <field name="name">Analista de Datos</field>
            <field name="numa_type">role</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="is_template">True</field>
            <field name="comment">Rol para analistas de datos. Incluye permisos para ver dashboards y exportar datos.</field>
            <field name="implied_ids" eval="[(4, ref('perm_view_dashboard')), (4, ref('perm_export_data'))]"/>
        </record>
    </data>
</odoo>
