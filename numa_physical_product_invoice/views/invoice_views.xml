<?xml version="1.0"?>
<odoo>
    <data>

        <!--
            [20.0] The invoice lines widget lost its inner form. Up to 18.0
            `field[@name='invoice_line_ids']` held a `<form>` as well as a `<list>`, and
            this view added the dimensions to both. Odoo 20 has `<list>` and `<kanban>`
            only, so the three `form` anchors could not be located and the module did not
            install.

            The fields moved into the list as optional columns, which is where a user
            reads them anyway. The `name` anchor also moved: it now lives inside
            `<column name="product_and_description">`, so the insert hangs off that
            column rather than off the list.
        -->
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/list//column[@name='product_and_description']"
                       position="after">
                    <field name="unit_width" optional="hide"/>
                    <field name="unit_length" optional="hide"/>
                    <field name="unit_height" optional="hide"/>
                    <field name="unit_surface" optional="hide"/>
                    <field name="unit_weight" optional="hide"/>
                    <field name="unit_volume" optional="hide"/>
                    <field name="total_surface" optional="hide"/>
                    <field name="total_weight" optional="hide"/>
                    <field name="total_volume" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                       position="after">
                    <field name="price_base" column_invisible="1"/>
                    <field name="price_qty" invisible="price_base == 'normal'" optional="show"/>
                    <field name="unit_price_uom_id" readonly="1" force_save="1"
                           invisible="price_base == 'normal'" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/list/field[@name='credit']" position="after">
                    <field name="price_base" column_invisible="1"/>
                    <field name="price_qty" column_invisible="1"/>
                    <field name="unit_price_uom_id" column_invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='other_info']/group[@id='other_tab_group']" position="after">
                    <group string="Logistic Information" name="logistic_information" colspan="2"
                           invisible="move_type not in ['out_invoice', 'out_refund']">
                        <field name="invoice_weight"/>
                        <field name="invoice_volume"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
