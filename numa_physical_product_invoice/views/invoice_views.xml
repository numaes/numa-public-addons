<?xml version="1.0"?>
<odoo>
    <data>

        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/form/sheet" position="inside">
                    <group>
                        <group>
                            <field name="unit_width"/>
                            <field name="unit_length"/>
                            <field name="unit_height"/>
                        </group>
                        <group>
                            <field name="unit_surface"/>
                            <field name="unit_weight"/>
                            <field name="unit_volume"/>
                        </group>
                        <group>
                            <field name="total_surface"/>
                            <field name="total_weight"/>
                            <field name="total_volume"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="after">
                    <field name="price_qty"/>
                    <field name="unit_price_uom_id"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                    <field name="unit_width" optional="hide"/>
                    <field name="unit_length" optional="hide"/>
                    <field name="unit_height" optional="hide"/>
                    <field name="unit_surface" optional="hide"/>
                    <field name="unit_weight" optional="hide"/>
                    <field name="unit_volume" optional="hide"/>
                    <field name="total_surface" optional="hide"/>
                    <field name="total_weight" optional="hide"/>
                    <field name="total_volume" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                    <field name="price_base" invisible="1"/>
                    <field name="price_qty" attrs="{'invisible': [('price_base', '=', 'normal')]}"/>
                    <field name="unit_price_uom_id" readonly="1" force_save="1" attrs="{'invisible': [('price_base', '=', 'normal')]}"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/form//field[@name='credit']" position="after">
                    <field name="price_base" invisible="1"/>
                    <field name="price_qty" invisible="1"/>
                    <field name="unit_price_uom_id" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/list/field[@name='credit']" position="after">
                    <field name="price_base" invisible="1"/>
                    <field name="price_qty" invisible="1"/>
                    <field name="unit_price_uom_id" invisible="1"/>
                </xpath>
                <xpath expr="//div[@name='journal_div']/.." position="after">
                    <group string="Logistic Information" name="logistic_information" colspan="4">
                        <field name="invoice_weight"/>
                        <field name="invoice_volume"/>
                    </group>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
