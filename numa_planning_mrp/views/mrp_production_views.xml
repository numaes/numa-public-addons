<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_numa" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.numa</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_numa_planning" type="object" class="oe_stat_button" icon="fa-tasks">
                    <div class="o_stat_info">
                        <span class="o_stat_text">View Planning</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
